# Optional API-key provider only. ChatGPT sign-in does not need an API key.
# Server only. Copy to .env and fill locally; never use VITE_ for secrets.
OPENAI_API_KEY=
# Used only for the API-key provider. ChatGPT models come from your account.
OPENAI_MODEL=gpt-4.1-mini
AI_PORT=5075
# Per-process cap, resets at UTC midnight. Also set a project budget in API Platform.
AI_DAILY_REQUEST_LIMIT=100
